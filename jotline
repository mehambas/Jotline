#!/bin/sh
APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$APP_DIR/.venv/bin/python" ]; then
    echo "Önce kurulum: python3 -m venv $APP_DIR/.venv && $APP_DIR/.venv/bin/pip install -r $APP_DIR/requirements.txt" >&2
    exit 1
fi
exec "$APP_DIR/.venv/bin/python" "$APP_DIR/notes.py" "$@"
